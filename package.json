		"dotenv": "^17.2.4",
		"kuroshiro": "^1.2.0",
		"kuroshiro-analyzer-kuromoji": "^1.1.0",
		"luxon": "^3.0.1",
		"marked": "^18.0.14",
		"node-fetch": "^2.7.0",
		"sk-lanyard": "^0.1.5",
		"ssh2-sftp-client": "^12.1.1",
		"uuid": "^13.0.0"
	}
